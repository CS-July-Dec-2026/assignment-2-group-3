/**
 * FIXED VERSION of the CORS middleware — for the write-up / demo comparison.
 * Replace the vulnerable middleware block in server.js with this.
 */

// A real allowlist of origins that are actually allowed to make
// credentialed requests to this API.
const ALLOWED_ORIGINS = [
  'http://localhost:4000'   // in a real app: 'https://app.bankdash.com'
];

app.use((req, res, next) => {
  const origin = req.headers.origin;

  // Only reflect the origin if it's explicitly on the allowlist.
  // Never do `res.header('Access-Control-Allow-Origin', origin)`
  // unconditionally, and never use '*' together with credentials.
  if (origin && ALLOWED_ORIGINS.includes(origin)) {
    res.header('Access-Control-Allow-Origin', origin);
    res.header('Access-Control-Allow-Credentials', 'true');
    res.header('Vary', 'Origin'); // important: prevents cache poisoning across origins
  }

  res.header('Access-Control-Allow-Methods', 'GET,POST,OPTIONS');
  res.header('Access-Control-Allow-Headers', 'Content-Type');

  if (req.method === 'OPTIONS') return res.sendStatus(204);
  next();
});

// Additional defense-in-depth (not a CORS fix, but good practice):
// - Use SameSite=Strict cookies where possible for sensitive session cookies.
// - Require a custom header or CSRF token for state-changing requests.
// - Never assume "logged in" == "request came from our own frontend".
